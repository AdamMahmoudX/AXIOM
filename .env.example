# Site
VITE_WEBSITE_URL=https://axiomx.space.minimax.io

# Backend API (optional — localStorage mock used when unset)
# Use /api with `pnpm dev:api` + Vite proxy for local backend auth:
VITE_API_BASE_URL=

# Google OAuth (optional — mock auth used when unset)
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=

# API server (pnpm dev:api)
PORT=3001
JWT_SECRET=axiomx-dev-secret-change-me
CORS_ORIGIN=http://localhost:5173
