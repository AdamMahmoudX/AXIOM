# Site
VITE_WEBSITE_URL=

# Production authentication requires a real backend API.
VITE_API_BASE_URL=

# Optional Firebase client config overrides (defaults are in src/config/firebase.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Configure these only in the actual backend deployment environment.
# Never use a development/default secret in production.
PORT=3001
JWT_SECRET=
CORS_ORIGIN=
