# Site
VITE_WEBSITE_URL=

# Production authentication requires a real backend API.
VITE_API_BASE_URL=

# Google OAuth is unavailable until a backend callback is implemented.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=

# Configure these only in the actual backend deployment environment.
# Never use a development/default secret in production.
PORT=3001
JWT_SECRET=
CORS_ORIGIN=
