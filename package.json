{
  "name": "axiomx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite ",
    "build": "vite build",
    "build:prod": "vite build",
    "lint": "eslint .",
    "lint:core": "eslint src/utils src/api src/config src/routes src/services/auth src/components/ProtectedRoute.tsx src/context/AuthContext.tsx src/context/SEOSettingsContext.tsx src/lib/AnalyticsManager.tsx src/lib/SearchConsoleManager.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit",
    "validate": "npm run typecheck:strict && npm run typecheck:api && npm run build",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "preview": "vite preview",
    "install-deps": "pnpm install",
    "clean": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
